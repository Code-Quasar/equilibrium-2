; Engine configuration file.
; Standalone graphical client for EQUILIBRIUM. It talks to the authoritative
; server only through protocol v1 over WebSocket and shares no res:// code with
; the root (server) project.
config_version=5

[application]

config/name="EQUILIBRIUM Client"
config/description="Four cities. One shared population. Twenty minutes."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1170
window/size/viewport_height=540
window/size/window_width_override=1170
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.373, 0.561, 0.306, 1)
